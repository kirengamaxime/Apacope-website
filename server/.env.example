PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/apacope
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
MAX_UPLOAD_MB=10

# Email (password reset links). Gmail example: enable 2-step verification, then create an
# "App password" at https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourschool@gmail.com
SMTP_PASS=your-16-letter-app-password
MAIL_FROM=Groupe Scolaire APACOPE <yourschool@gmail.com>
